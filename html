        const barHunger = document.getElementById('bar-hunger');
        const barThirst = document.getElementById('bar-thirst');
        const barStamina = document.getElementById('bar-stamina');
        const valHealth = document.getElementById('val-health');
        const valHunger = document.getElementById('val-hunger');
        const valThirst = document.getElementById('val-thirst');
        const valStamina = document.getElementById('val-stamina');

        // Three.js Core Variables
        let scene, camera, renderer, clock;
        let playerGroup, playerMesh, headMesh, limbAnimTime = 0;
        let leftLeg, rightLeg, leftArm, rightArm;
        let sunLight;

        // Minimap Variables
